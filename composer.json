{
    "name": "daniel-km/omeka-s-module-translator",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Translate resources values and site page block strings manually or automatically.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "translation",
        "internationalisation",
        "i18n",
        "localisation"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Translator",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Translator/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2412)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "deeplcom/deepl-php": "^1.12",
        "symfony/http-client": "^5.4",
        "nyholm/psr7": "^1.8"
    },
    "replace": {
        "psr/container": "*",
        "symfony/polyfill-php80": "*"
    },
    "autoload": {
        "psr-4": {
            "Translator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TranslatorTest\\": "tests/TranslatorTest/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "installer-name": "Translator",
        "configurable": true
    }
}
