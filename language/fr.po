msgid "DeepL translation failed: {error}"
msgstr "Échec de la traduction DeepL : {error}"

#: Module.php:1283
msgid ""
"Translating all resources in background (job {link_job}#{job_id}{link_end}, "
"{link_log}logs{link_end})."
msgstr ""
"Traduction lancée en arrière-plan (tâche {link_job}#{job_id}{link_end}, "
"{link_log}journaux{link_end})."

#: Module.php:1309
msgid ""
"Translating the copied pages of the site groups in background (job {link_job}"
"#{job_id}{link_end}, {link_log}logs{link_end})."
msgstr ""
"Traduction des pages copiées dans le groupe de site en arrière-plan "
"{link_job}#{job_id}{link_end}, {link_log}journaux{link_end})."

#: src/Job/TranslateAll.php:35
msgid "No language pairs configured."
msgstr "Aucune paire de langue configurée."

#: src/Job/TranslateAll.php:47
msgid "No properties to translate configured."
msgstr "Aucune propriété n’a été définie pour la traduction."

#: src/Job/TranslateAll.php:56
msgid "Starting batch translation for: {types}."
msgstr "Lancement de la traduction en lot pour : {types}."

#: src/Job/TranslateAll.php:69
msgid "No new texts to translate."
msgstr "Aucun nouveau texte à traduire."

#: src/Job/TranslateAll.php:139
msgid "Collecting texts from {count} {type}."
msgstr "Collecte de textes de {count} {type}."

#: src/Job/TranslateAll.php:209
msgid ""
"{type}: {done}/{total} processed, {unique} unique texts collected, {mem} MB "
"memory."
msgstr ""
"{type}: {done}/{total} traités, {unique} textes uniques collectés, {mem} Mo "
"mémoire."

#: src/Job/TranslateAll.php:307
msgid "No resolvable properties to include."
msgstr "Aucune propriété connue à inclure."

#: src/Job/TranslateAll.php:414
msgid ""
"Collecting texts via SQL on table value (terms: {nbi} include / {nbe} "
"exclude, size filter: {sf})."
msgstr ""
"Collecte des textes via sql sur la table des valeurs (termes : {nbi} "
"inclus / {nbe} exclus, filtre de taille : {sf})."

#: src/Job/TranslateAll.php:461
msgid ""
"SQL collect: {rows} rows scanned, {unique} unique texts, {mem} MB memory."
msgstr ""
"Collecte SQL : {rows} lignes scannés, {unique} unique textes, {mem} Mo "
"mémoire."

#: src/Job/AbstractTranslate.php:87
msgid "No DeepL API key configured."
msgstr "Aucune clé api DeepL configurée."

#: src/Job/AbstractTranslate.php:106
msgid ""
"Collected {texts} unique texts ({chars} characters) across {pairs} language "
"pair(s)."
msgstr ""
"Collecte {texts} textes uniques ({chars} caractères) pour {pairs} paires de "
"langues."

#: src/Job/AbstractTranslate.php:136
msgid "Job stopped by user."
msgstr "Tâche interrompue par l’utilisateur."

#: src/Job/AbstractTranslate.php:159
msgid "{count} texts to translate for {source} → {target}."
msgstr "{count} textes à traduire pour {source} → {target}."

#: src/Job/AbstractTranslate.php:180
msgid "Batch translation completed: {count} translations created."
msgstr "Traduction en lot terminée : {count} traductions créées."

#: src/Job/AbstractTranslate.php:189 src/Job/TranslatePages.php:199
msgid "Job aborted: DeepL quota exceeded. Re-run later when quota resets."
msgstr ""
"Tâche arrétée : quota DeepL dépassé. Relancer plus tard lorsque le quota "
"sera réinitialisé."

#: src/Job/AbstractTranslate.php:214
msgid "Session summary, translated by pair of languages: {list}."
msgstr "Résumé de la session, traduit par les paires de langues : {list}."

#: src/Job/AbstractTranslate.php:250
msgid "Translations stored in the database, all sessions included: {list}."
msgstr ""
"Traductions enregistrées dans la base de données, toutes sessions "
"confondues : {list}."

#: src/Job/AbstractTranslate.php:500
msgid ""
"Database {version} does not support JSON_TABLE; using byte-exact fallback. "
"Some translated strings may be re-sent to DeepL when collation collapses "
"(apostrophes, accents, NFC/NFD, ligatures). Per-item try/catch prevents DB "
"duplicates but burns quota."
msgstr ""
"La base {version} ne gère pas JSON_TABLE. Déduplication via chaîne exacte. "
"Certaines chaînes traduites peuvent être renvoyées à DeepL lorsque la "
"collation donne un résultat différent (apostrophes, accents, NFC/NFD, "
"ligatures). Le tri par ressource évite les doublons dans la base, mais "
"utilise le quota."

#: src/Job/AbstractTranslate.php:625
msgid "Translation create failed: {message}"
msgstr "Échec de la création de la traduction : {message}"

#: src/Job/AbstractTranslate.php:634
msgid "{source} → {target}: {skipped} duplicates skipped in chunk."
msgstr "{source} → {target}: {skipped} doublons ignorés dans le lot."

#: src/Job/AbstractTranslate.php:646
msgid "{source} → {target}: {done}/{total} translations created."
msgstr "{source} → {target}: {done}/{total} traductions créées."

#: src/Job/AbstractTranslate.php:720
msgid "DeepL quota exceeded: {error}. Aborting job."
msgstr "Dépassement du quota DeepL : {error}. Tâche arrétée."

#: src/Job/TranslatePages.php:128
msgid "No keys of page blocks to translate configured."
msgstr "Aucune clé des blocs de page n’est traductible."

#: src/Job/TranslatePages.php:159
msgid ""
"No pair of languages with an explicit source language is configured, so the "
"direction of the translation of the pages is unknown."
msgstr ""
"Aucune paire de langues avec une langue source explicitement indiquée n’est "
"configurée ; le sens de traduction des pages est donc inconnu."

#: src/Job/TranslatePages.php:166
msgid ""
"The module Internationalisation is required to translate the pages: it "
"manages the site groups and the relations between the copied pages."
msgstr ""
"Le module « Internationalisation » est nécessaire pour traduire les pages : "
"il gère les groupes de sites et les relations entre les pages copiées."

#: src/Job/TranslatePages.php:174
msgid ""
"No multilingual site group is configured in the module Internationalisation."
msgstr ""
"Aucun groupe de sites multilingues n’est configuré dans le module "
"Internationalisation."

#: src/Job/TranslatePages.php:180
msgid "Starting translation of the pages of {count} site groups."
msgstr "Début de la traduction des pages de {count} groupes de sites."

#: src/Job/TranslatePages.php:219
msgid "No page to translate in place."
msgstr "Aucune page à traduire sur place."

#: src/Job/TranslatePages.php:233
msgid "The source language \"{lang}\" is not supported."
msgstr "La langue source \"{lang}\" n’est pas prise en charge."

#: src/Job/TranslatePages.php:240
msgid "Starting translation of {count} pages in place, from {source}."
msgstr "Début de la traduction de {count} pages en place, depuis {source}."

#: src/Job/TranslatePages.php:262
msgid ""
"Page #{page_id}: the locale of its site is not supported as a target "
"language, so it is skipped."
msgstr ""
"Page #{page_id} : la langue de ce site n’est pas prise en charge comme "
"langue cible et est donc ignorée."

#: src/Job/TranslatePages.php:273
msgid ""
"Page #{page_id}: the source language is the language of its site, so it is "
"skipped."
msgstr ""
"Page #{page_id} : la langue source étant celle du site, elle est ignorée."

#: src/Job/TranslatePages.php:543
msgid ""
"Page #{page_id}: there is no block at position {position} to translate from "
"page #{source_page_id}."
msgstr ""
"Page #{page_id} : il n’y a pas de bloc à la position {position} à traduire à "
"partir de la page #{source_page_id}."

#: src/Job/TranslatePages.php:550
msgid ""
"Page #{page_id}: the block at position {position} is a \"{layout}\", but the "
"original one is a \"{layout_2}\", so it is skipped."
msgstr ""
"Page #{page_id} : le bloc position {position} est de type « {layout} », mais "
"celui d’origine est de type « {layout_2} » ; il est donc ignoré."

#: src/Job/TranslatePages.php:597
msgid "translated"
msgstr "traduit"

#: src/Job/TranslatePages.php:598
msgid "retranslated"
msgstr "retraduit"

#: src/Job/TranslatePages.php:599
msgid "partly translated"
msgstr "partiellement traduit"

#: src/Job/TranslatePages.php:600
msgid "unchanged"
msgstr "inchangé"

#: src/Job/TranslatePages.php:601
msgid "mirror pages skipped"
msgstr "pages miroir ignorées"

#: src/Job/TranslatePages.php:602
msgid "failed"
msgstr "échec"

#: src/Job/TranslatePages.php:616
msgid "No page was translated."
msgstr "Aucune page n’était traduite."

#: src/Job/TranslatePages.php:622
msgid "Pages: {list}. {blocks} blocks updated."
msgstr "Pages : {list}. {blocks} blocs mis à jour."

#: src/Job/TranslatePages.php:633
msgid "These pages were not fully translated: #{list}."
msgstr "Ces pages n’ont pas été entièrement traduites : #{list}."

#: src/Job/TranslatePages.php:950
msgid ""
"The full text of the page #{page_id} was not saved. Run the indexation of "
"the full text manually. Exception: {exception}"
msgstr ""
"Le texte intégral de la page #{page_id} n’a pas été enregistré. Lancer "
"manuellement l’indexation du texte intégral. Exception : {exception}"

#: src/Job/TranslateResources.php:53
msgid "Translator: starting translation of {count} resources."
msgstr "Translateur : début de la traduction de {count} ressources."

#: src/Job/TranslateResources.php:78
