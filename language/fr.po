#: data/scripts/upgrade.php:38 Module.php:319
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Le module %1$s doit être mis à niveau à la version %2$s ou supérieure."

#: data/scripts/upgrade.php:42 data/scripts/upgrade.php:51
msgid "Missing requirement. Unable to upgrade."
msgstr "Pré-requis absent. Impossible de mettre à jour."

#: Module.php:327
#, php-format
msgid "This version of module %1$s requires a version of php ≥ %2$s."
msgstr "Cette version du module %1$s requiert une version de php ≥ %2$s."

#: data/scripts/upgrade.php:47
msgid "This version of module {module} requires a version of php ≥ {version}."
msgstr "La version du module {module} requiert une version de php ≥ {version}."

#: data/scripts/upgrade.php:72
msgid "Setting \"{key}\" was split into \"{key}\" + \"{key}_size\"."
msgstr "Le paramètre \"{key}\" a été séparé en \"{key}\" + \"{key}_size\"."

#: Module.php:384
msgid ""
"Fill your DeepL api key, then set languages to translate in {link}main "
"settings{link_end}."
msgstr ""
"Indiquez votre clé api DeepL, puis définissez les langues à traduire dans "
"{link}les paramètres généraux{link_end}."

#: Module.php:1026
msgid "The following source languages are not supported currently: {list}."
msgstr ""
"Les langues sources suivantes ne sont pas prises en charge actuellement : "
"{list}."

#: Module.php:1032
msgid "The following target languages are not supported currently: {list}."
msgstr ""
"Les langues cibles suivantes ne sont pas prises en charge actuellement : "
"{list}."

#: Module.php:1124 src/Job/TranslateAll.php:1001
msgid "DeepL translation failed: {error}"
msgstr "Échec de la traduction DeepL : {error}"

#: Module.php:1164
msgid ""
"Translating all resources in background (job {link_job}#{job_id}{link_end}, "
"{link_log}logs{link_end})."
msgstr ""
"Traduction lancée en arrière-plan (tâche {link_job}#{job_id}{link_end}, "
"{link_log}journaux{link_end})."

#: src/Job/TranslateAll.php:80
msgid "No DeepL API key configured."
msgstr "Aucune clé api DeepL configurée."

#: src/Job/TranslateAll.php:88
msgid "No language pairs configured."
msgstr "Aucune paire de langue configurée."

#: src/Job/TranslateAll.php:100
msgid "No properties to translate configured."
msgstr "Aucune propriété n’a été définie pour la traduction."

#: src/Job/TranslateAll.php:109
msgid "Starting batch translation for: {types}."
msgstr "Lancement de la traduction en lot pour : {types}."

#: src/Job/TranslateAll.php:122
msgid "No new texts to translate."
msgstr "Aucun nouveau texte à traduire."

#: src/Job/TranslateAll.php:135
msgid ""
"Collected {texts} unique texts ({chars} characters) across {pairs} language "
"pair(s)."
msgstr ""
"Collecte {texts} textes uniques ({chars} caractères) pour {pairs} paires de "
"langues."

#: src/Job/TranslateAll.php:157
msgid "Job stopped by user."
msgstr "Tâche interrompue par l’utilisateur."

#: src/Job/TranslateAll.php:180
msgid "{count} texts to translate for {source} → {target}."
msgstr "{count} textes à traduire pour {source} → {target}."

#: src/Job/TranslateAll.php:200
msgid "Batch translation completed: {count} translations created."
msgstr "Traduction en lot terminée : {count} traductions créées."

#: src/Job/TranslateAll.php:209
msgid "Job aborted: DeepL quota exceeded. Re-run later when quota resets."
msgstr ""
"Tâche arrétée : quota DeepL dépassé. Relancer plus tard lorsque le quota "
"sera réinitialisé."

#: src/Job/TranslateAll.php:224
msgid "--- Session summary ---"
msgstr "--- Données de la session ---"

#: src/Job/TranslateAll.php:228
msgid "{pair}: {translated} translated, {remaining} not translated."
msgstr "{pair}: {translated} traduits, {remaining} non traduits."

#: src/Job/TranslateAll.php:259
msgid "--- Database totals (all sessions) ---"
msgstr "--- Totaux dans la base (toutes les sessions) ---"

#: src/Job/TranslateAll.php:263
msgid "{source} → {target}: {count} translations stored."
msgstr "{source} → {target}: {count} traductions enregistrées."

#: src/Job/TranslateAll.php:331
msgid "Collecting texts from {count} {type}."
msgstr "Collecte de textes de {count} {type}."

#: src/Job/TranslateAll.php:401
msgid ""
"{type}: {done}/{total} processed, {unique} unique texts collected, {mem} MB "
"memory."
msgstr ""
"{type}: {done}/{total} traités, {unique} textes uniques collectés, {mem} Mo "
"mémoire."

#: src/Job/TranslateAll.php:499
msgid "No resolvable properties to include."
msgstr "Aucune propriété connue à inclure."

#: src/Job/TranslateAll.php:595
msgid ""
"Collecting texts via SQL on table value (terms: {nbi} include / {nbe} "
"exclude, size filter: {sf})."
msgstr ""
"Collecte des textes via sql sur la table des valeurs (termes : {nbi} "
"inclus / {nbe} exclus, filtre de taille : {sf})."

#: src/Job/TranslateAll.php:642
msgid ""
"SQL collect: {rows} rows scanned, {unique} unique texts, {mem} MB memory."
msgstr ""
"Collecte SQL : {rows} lignes scannés, {unique} unique textes, {mem} Mo "
"mémoire."

#: src/Job/TranslateAll.php:791
msgid ""
"Database {version} does not support JSON_TABLE; using byte-exact fallback. "
"Some translated strings may be re-sent to DeepL when collation collapses "
"(apostrophes, accents, NFC/NFD, ligatures). Per-item try/catch prevents DB "
"duplicates but burns quota."
msgstr ""
"La base {version} ne gère pas JSON_TABLE. Déduplication via chaîne exacte. "
"Certaines chaînes traduites peuvent être renvoyées à DeepL lorsque la "
"collation donne un résultat différent (apostrophes, accents, NFC/NFD, "
"ligatures). Le tri par ressource évite les doublons dans la base, mais "
"utilise le quota."

#: src/Job/TranslateAll.php:821
msgid "Unsupported source language: {lang}."
msgstr "Langue source non prise en charge : {lang}"

#: src/Job/TranslateAll.php:831
msgid "Unsupported target language: {lang}."
msgstr "Langue cible non prise en charge : {lang}"

#: src/Job/TranslateAll.php:904
msgid "Translation create failed: {message}"
msgstr "Échec de la création de la traduction : {message}"

#: src/Job/TranslateAll.php:913
msgid "{source} → {target}: {skipped} duplicates skipped in chunk."
msgstr "{source} → {target}: {skipped} doublons ignorés dans le lot."

#: src/Job/TranslateAll.php:925
msgid "{source} → {target}: {done}/{total} translations created."
msgstr "{source} → {target}: {done}/{total} traductions créées."

#: src/Job/TranslateAll.php:995
msgid "DeepL quota exceeded: {error}. Aborting job."
msgstr "Dépassement du quota DeepL : {error}. Tâche arrétée."

#: src/Job/TranslateResources.php:53
msgid "Translator: starting translation of {count} resources."
msgstr "Translateur : début de la traduction de {count} ressources."

#: src/Job/TranslateResources.php:78
msgid ""
"Translator: {done}/{total} resources processed, {created} translations "
"queued, {mem} MB memory."
msgstr ""
"Translateur : {done}/{total} ressources traitées, {created} traductions dans "
"la file, {mem} Mo mémoire."

#: src/Job/TranslateResources.php:128
msgid "Translator: stored {count} translations for {resources} resources."
msgstr ""
"Translateur : enregistré {count} traductions pour {resources} ressources."

#: src/Form/SettingsFieldset.php:14
msgid "Internationalisation: Resources"
msgstr "Internationalisation: Ressources"

#: src/Form/SettingsFieldset.php:17
msgid "Internationalisation: resources"
msgstr "Internationalisation : ressources"

#: src/Form/SettingsFieldset.php:31
msgid "Default language for values without any one"
msgstr "Langue par défaut pour les valeurs sans"

#: src/Form/SettingsFieldset.php:32
msgid ""
"The language should be a 2-letter iso code (ISO 3166-1) supported by the "
"translation service."
msgstr ""
"La langue doit être un code ISO à 2 lettres (ISO 3166-1) pris en charge par "
"le service de traduction."

#: src/Form/SettingsFieldset.php:35
msgid "Automatic"
msgstr "Automatique"

#: src/Form/SettingsFieldset.php:36
msgid "Skip"
msgstr "Ignorer"

#: src/Form/SettingsFieldset.php:43
msgid "Select language…"
msgstr "Choisir la langue…"

#: src/Form/SettingsFieldset.php:51
msgid "Target languages or pairs of languages to translate"
msgstr "Langues cibles ou paires de langues à traduire"

#: src/Form/SettingsFieldset.php:52
msgid ""
"The source language will be automatically defined when not set. For pairs, "
"separate source and target with a \"=\", one by line. The source language "
"should be a 2-letter iso code (ISO 3166-1) supported by the translation "
"service. The target language may have the localization code if supported."
msgstr ""
"La langue source sera automatiquement définie si elle n’est pas indiquée. "
"Pour les paires, séparez la source et la cible par un « = », une ligne à la "
"fois. La langue source doit être un code ISO à 2 lettres (ISO 3166-1) pris "
"en charge par le service de traduction. La langue cible peut comporter le "
"code de localisation s’il est pris en charge."

#: src/Form/SettingsFieldset.php:75
msgid "Properties to translate"
msgstr "Propriétés à traduire"

#: src/Form/SettingsFieldset.php:76
msgid ""
"Explicit list of properties to translate. Combine with size filter below to "
"include all values within a size range."
msgstr ""
"Liste explicite de propriété à traduire. Combiner avec le filtre de taille "
"ci-dessous pour inclure toutes les valeurs correspondantes."

#: src/Form/SettingsFieldset.php:80
msgid "Resource metadata"
msgstr "Métadonnées de la ressource"

#: src/Form/SettingsFieldset.php:82
msgid "All properties"
msgstr "Toutes les propriétés"

#: src/Form/SettingsFieldset.php:92 src/Form/SettingsFieldset.php:129
msgid "Select properties…"
msgstr "Choisir des propriétés…"

#: src/Form/SettingsFieldset.php:100
msgid "Size filter to include"
msgstr "Filtrer par taille à inclure"

#: src/Form/SettingsFieldset.php:101
msgid ""
"Add all property values matching this size, in addition to the explicit list "
"above."
msgstr ""
"Ajouter toutes les propriétés correspondant à cette taille, outre la liste "
"explicite ci-dessus."

#: src/Form/SettingsFieldset.php:103 src/Form/SettingsFieldset.php:140
msgid "No size filter"
msgstr "Aucun filtre de taille"

#: src/Form/SettingsFieldset.php:104 src/Form/SettingsFieldset.php:141
msgid "All values less or equal to 500 characters"
msgstr "Toutes les valeurs de moins de 500 caractères"

#: src/Form/SettingsFieldset.php:105 src/Form/SettingsFieldset.php:142
msgid "All values less or equal to 1000 characters"
msgstr "Toutes les valeurs de moins de 1000 caractères"

#: src/Form/SettingsFieldset.php:106 src/Form/SettingsFieldset.php:143
msgid "All values less or equal to 5000 characters"
msgstr "Toutes les valeurs de moins de 5000 caractères"

#: src/Form/SettingsFieldset.php:107 src/Form/SettingsFieldset.php:144
msgid "All values more than 500 characters"
msgstr "Toutes les valeurs de plus de 500 caractères"

#: src/Form/SettingsFieldset.php:108 src/Form/SettingsFieldset.php:145
msgid "All values more than 1000 characters"
msgstr "Toutes les valeurs de plus de 1000 caractères"

#: src/Form/SettingsFieldset.php:109 src/Form/SettingsFieldset.php:146
msgid "All values more than 5000 characters"
msgstr "Toutes les valeurs de plus de 5000 caractères"

#: src/Form/SettingsFieldset.php:121
msgid "Properties not to translate"
msgstr "Propriétés à ne pas traduire"

#: src/Form/SettingsFieldset.php:137
msgid "Size filter to exclude"
msgstr "Filtrer par taille à exclure"

#: src/Form/SettingsFieldset.php:138
msgid ""
"Skip all property values matching this size, in addition to the explicit "
"exclude list above."
msgstr ""
"Ignorer toutes les valeurs correspondant à la taille, outre la liste des "
"propriétés exclues ci-dessus."

#: src/Form/SettingsFieldset.php:159
msgid "Lauch a job to translate all existing resources"
msgstr "Lancer une tâche pour traduire toutes les ressources existantes"

#: src/Form/SettingsFieldset.php:160
msgid ""
"Launch a background job to translate all existing resources. Only new texts "
"that have no translation yet will be sent to DeepL."
msgstr ""
"Lancer la tâche de traduction de toutes les ressources en arrière-plan. "
"Seuls les nouveaux textes sans traduction seront envoyés à DeepL."

#: src/Form/ConfigForm.php:17
msgid "DeepL api key for automatic translation"
msgstr "Clé api DeepL pour la traduction automatique"

#: src/Api/Adapter/TranslationAdapter.php:105
msgid "The translation requires a target language."
msgstr "La traduction nécessite une langue cible."

#: src/Api/Adapter/TranslationAdapter.php:110
msgid "The translation requires a source string."
msgstr "La traduction nécessite une chaîne source."

#: src/Api/Adapter/TranslationAdapter.php:115
msgid "The translation requires a translated string."
msgstr "La traduction nécessite une chaîne traduite."

#: src/Api/Adapter/TranslationAdapter.php:197
msgid ""
"The string \"{string}\", source language \"{language}\" and target language "
"\"{language_2}\" to translate must be unique."
msgstr ""
"La chaîne « {string} », la langue source « {language} » et la langue cible "
"« {language_2} » à traduire doivent être uniques."

