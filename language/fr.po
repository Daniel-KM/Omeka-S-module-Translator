"The foreign key \"{name}\" of the table \"translate_page\" could not be "
"created: {message}"
msgstr ""
"La clé étrangère \"{name}\" de la table \"translate_page\" ne peut pas être "
"créée : {message}"

#: data/scripts/upgrade.php:154
msgid "It is now possible to translate site pages individually."
msgstr "Il est désormais possible de traduire les pages individuellement."

#: Module.php:417
msgid ""
"Fill your DeepL api key, then set languages to translate in {link}main "
"settings{link_end}."
msgstr ""
"Indiquez votre clé api DeepL, puis définissez les langues à traduire dans "
"{link}les paramètres généraux{link_end}."

#: Module.php:1147 src/Job/AbstractTranslate.php:552
msgid "The following source languages are not supported currently: {list}."
msgstr ""
"Les langues sources suivantes ne sont pas prises en charge actuellement : "
"{list}."

#: Module.php:1153 src/Job/AbstractTranslate.php:558
msgid "The following target languages are not supported currently: {list}."
msgstr ""
"Les langues cibles suivantes ne sont pas prises en charge actuellement : "
"{list}."

